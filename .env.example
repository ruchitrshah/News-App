# Copy to .env and fill in. Never commit .env.
#
# EXPO_PUBLIC_ values are bundled into the app — put nothing secret in them.
# Everything else is read only by the local pipeline server (server/).

# ── Pipeline server (npm run pipeline) ───────────────────────────────────────
# fal.ai key: research (LLM + web search), voiceover and video generation.
FAL_KEY=
# Shared secret between the app and your server. Any long random string;
# EXPO_PUBLIC_PIPELINE_TOKEN below must match it.
PIPELINE_TOKEN=
# Cap on briefings that generate AI video per day (cost guard).
MAX_VIDEO_REQUESTS_PER_DAY=6
# How far back (days) research treats news as fresh.
FRESH_DAYS=7
# Public web build (scripts/go-live.sh): its own token, and a cap on the
# new questions it can ask per day. Your own app's token isn't capped.
WEB_PIPELINE_TOKEN=
MAX_QUESTIONS_PER_DAY=10

# ── App → server ─────────────────────────────────────────────────────────────
# Your Mac's LAN address, so a phone on the same Wi-Fi can reach the server,
# e.g. http://192.168.1.20:8787 (the server prints it when it starts).
EXPO_PUBLIC_PIPELINE_URL=
EXPO_PUBLIC_PIPELINE_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────────
# Voice in Expo Go (no native speech module): cloud transcription.
# Prototype only — this key ships in the bundle.
EXPO_PUBLIC_OPENAI_API_KEY=

# ── Google sign-in (Supabase Auth) ───────────────────────────────────────────
# Your Supabase project's URL and publishable key (public by design).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google Cloud OAuth client IDs. Sign-in — required to make briefings —
# switches on in the app and the server once the web client ID is set.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# New briefings each signed-in person can make per day.
MAX_QUESTIONS_PER_USER_PER_DAY=10
